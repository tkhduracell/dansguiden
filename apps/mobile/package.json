{
  "name": "dansguiden",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "test:unit": "vue-cli-service test:unit",
    "test:e2e": "vue-cli-service test:e2e",
    "lint": "vue-cli-service lint",
    "ios:watch": "vue-cli-service serve --host=0.0.0.0 --port=3000",
    "ios:open": "cap open ios",
    "ios:open:live": "cap run ios -l --external",
    "ios:release": "npm run build && cap sync ios && cap open ios",
    "android:watch": "vue-cli-service serve --host=0.0.0.0 --port=3000",
    "android:open": "cap open android",
    "android:open:live": "cap run android -l --external",
    "android:release": "npm run build && cap sync android",
    "android:build": "cd android && ./gradlew --no-daemon bundleRelease",
    "android:upload": "cd android && ./gradlew --no-daemon publishBundle"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@ionic/vue": "^6.0.0",
    "@ionic/vue-router": "^6.0.0",
    "calendar-link": "^2.4.0",
    "core-js": "^3.6.5",
    "date-fns": "^2.29.3",
    "firebase": "^12.19.0",
    "google-calendar-url": "^0.0.5",
    "ionicons": "^6.0.3",
    "lodash": "^4.17.21",
    "v-calendar": "^3.0.0-alpha.8",
    "vue": "^3.2.21",
    "vue-router": "^4.0.12"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/jest": "^27.0.2",
    "@typescript-eslint/eslint-plugin": "^5.6.0",
    "@typescript-eslint/parser": "^5.6.0",
    "@vue/cli-plugin-babel": "~5.0.0-rc.1",
    "@vue/cli-plugin-e2e-cypress": "~5.0.0-rc.1",
    "@vue/cli-plugin-eslint": "~5.0.0-rc.1",
    "@vue/cli-plugin-router": "~5.0.0-rc.1",
    "@vue/cli-plugin-typescript": "~5.0.0-rc.1",
    "@vue/cli-plugin-unit-jest": "~5.0.0-rc.1",
    "@vue/cli-service": "~5.0.0-rc.1",
    "@vue/eslint-config-typescript": "^9.1.0",
    "@vue/test-utils": "^2.0.0-rc.16",
    "@vue/vue3-jest": "^27.0.0-alpha.3",
    "babel-jest": "^27.3.1",
    "cypress": "^16.1.0",
    "eslint": "^8.4.1",
    "eslint-plugin-vue": "^8.2.0",
    "jest": "^27.3.1",
    "ts-jest": "^27.0.7",
    "typescript": "^4.3.5"
  },
  "description": "An Ionic project"
}